# ==============================================================================
# Environment Configuration Template for Microservices Stack & API Gateway
# Lab 7: API Gateway, Service Discovery & Cloud Deployment
# ==============================================================================

# API Gateway Configuration
GATEWAY_PORT=8080
PORT=8080

# Service Discovery URLs (Used by API Gateway)
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# Internal Service Ports
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
HTTP_TIMEOUT_MS=4000

# Databases (Local Docker or MongoDB Atlas URI)
MONGO_HOST=mongodb
MONGO_PORT=27017
USER_MONGO_URI=mongodb://mongodb:27017/user_db
PRODUCT_MONGO_URI=mongodb://mongodb:27017/product_db
ORDER_MONGO_URI=mongodb://mongodb:27017/order_db

# MongoDB Atlas Cloud Production Example:


# Runtime
NODE_ENV=production
